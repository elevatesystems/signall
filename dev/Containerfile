# Development and test environment matching the target desktop (Fedora 40 / GNOME 46).
FROM registry.fedoraproject.org/fedora:40
RUN dnf -y install --setopt=install_weak_deps=False \
        python3 python3-pip python3-gobject gtk4 libadwaita webkitgtk6.0 \
        softhsm opensc p11-kit p11-kit-trust openssl gnutls-utils \
        xorg-x11-server-Xvfb mesa-dri-drivers dbus-daemon \
        dejavu-sans-fonts liberation-serif-fonts liberation-sans-fonts \
    && dnf clean all
WORKDIR /src
